# LavernaEvents Frontend Environment Configuration
# Copy this file to `.env` if you need to change anything locally.
#
# NOTE: both variables below are only read by PRODUCTION builds
# (`npm run build`). `npm run dev` always talks to http://<current-host>:8000/api.

# Production: the app calls its own origin; a Cloudflare Pages Function
# (functions/api/[[path]].ts) forwards /api/* to the Django backend.
VITE_API_BASE_URL=/api

# Production: backend origin, used only to resolve relative /media/... URLs.
VITE_API_ORIGIN=https://laverna-api.onrender.com